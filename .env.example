# Variable names only, placeholders only. Never put a real password here,
# in tests, or in example files.
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=railway

# TLS: "on" (default) serves a self-signed certificate and accepts
# sslmode=require connections; "off" disables TLS.
PG_SSL=on

# Optional first-boot dump import (first start on an empty data
# directory only). Set at most one; both empty means no import.
POSTGRES_INIT_DUMP_URL=
POSTGRES_INIT_DUMP_BASE64=

# Backup service only: how many dumps to keep in the bucket.
BACKUP_RETENTION_COUNT=14
